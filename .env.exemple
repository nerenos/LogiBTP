# Secrets de l'installation (copier en .env, jamais versionné). Lu par l'API au démarrage (dossier de l'API ou ses parents).
# Sur un serveur : « LogiBTP.Api env initialiser [LOCAL|INTERNET] » crée ce fichier (un .env existant est conservé), puis
# « env chiffrer » chiffre les valeurs sensibles (env:v1:…) par la clé de construction des binaires ; « env verifier ».
# Chaîne unique de chiffrement des valeurs secrètes en base (mots de passe des fiches). Générée à l'installation ;
# la changer rend illisibles les valeurs déjà chiffrées : sauvegarder ce fichier avec la base.
LOGIBTP_CLE_CHIFFREMENT=
# Déploiement : LOCAL (réseau local, TSE) ou INTERNET (serveur public : HSTS).
LOGIBTP_DEPLOIEMENT=LOCAL
# Réseau local et serveur TSE (CIDR, séparés par des virgules) : ni exclusion d'adresse, ni double facteur, ni limite de connexion.
LOGIBTP_ADRESSES_CONFIANCE=
# Proxys inverses déclarés (adresses ou CIDR) : seuls crus pour X-Forwarded-For / -Proto / -Host.
LOGIBTP_PROXYS=
# Origines CORS permises (vide : même origine seulement ; développement : http://localhost:5173 dans appsettings.Development.json).
LOGIBTP_CORS_ORIGINES=
# Niveau du journal technique (Error par défaut ; Warning, Information, Debug), lu au démarrage.
LOGIBTP_JOURNAL_NIVEAU=Error

# Boîtes de test du module Mail (essais avec de vraies boîtes, sans serveur de messagerie Docker). Facultatives : les
# tests d'intégration du Mail et de l'OAuth sont ignorés tant qu'elles sont vides. Utiliser des boîtes dédiées aux essais.
# Adresse qui reçoit les courriels d'essai (une boîte que l'on peut lire).
LOGIBTP_TEST_MAIL_DESTINATAIRE=
# Gmail grand public : serveurs fixes (smtp.gmail.com:465, imap.gmail.com:993).
LOGIBTP_TEST_MAIL_GMAIL_ADRESSE=
# Mot de passe d'application Google (double authentification du compte obligatoire) : essais sans OAuth.
LOGIBTP_TEST_MAIL_GMAIL_MOT_DE_PASSE_APPLICATION=
# Application Google de l'installation (console Google Cloud, client « application Web ») : essais OAuth 2.0.
LOGIBTP_TEST_MAIL_GOOGLE_CLIENT_ID=
LOGIBTP_TEST_MAIL_GOOGLE_CLIENT_SECRET=
# Exchange hébergé OVH (mot de passe) : serveurs au format hote:port, donnés par l'espace client OVH.
LOGIBTP_TEST_MAIL_OVH_ADRESSE=
LOGIBTP_TEST_MAIL_OVH_IDENTIFIANT=
LOGIBTP_TEST_MAIL_OVH_MOT_DE_PASSE=
LOGIBTP_TEST_MAIL_OVH_SMTP=
LOGIBTP_TEST_MAIL_OVH_IMAP=
