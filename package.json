{
  "name": "logibtp",
  "version": "0.2.0",
  "private": true,
  "description": "LogiBTP – socle, modules complémentaires et application",
  "workspaces": [
    "socle/js",
    "modules/metre/js",
    "modules/document/js",
    "modules/liste/js",
    "modules/fiche/js",
    "modules/ged/js",
    "modules/bibliotheque/js",
    "modules/graphe/js",
    "modules/annuaire/js",
    "modules/entreprises-fr/js",
    "modules/reglement/js",
    "modules/relance/js",
    "modules/crm/js",
    "modules/authentification/js",
    "modules/droits/js",
    "modules/calendrier/js",
    "modules/mail/js",
    "modules/execution/js",
    "modules/rentabilite/js",
    "modules/sous-traitance/js",
    "modules/stock/js",
    "modules/sav/js",
    "modules/comptabilite/js",
    "modules/pointage/js",
    "modules/planning/js",
    "modules/personnalisation/js",
    "modules/navigation/js",
    "modules/import/js",
    "modules/edition/js",
    "client",
    "docs"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "dev": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "exporter-resultats": "npm run exporter-resultats --workspaces --if-present",
    "rapport-dependances": "node scripts/rapport-dependances.mjs",
    "docs:dev": "npm run dev --workspace docs",
    "docs:build": "npm run build --workspace docs",
    "docs:preview": "npm run preview --workspace docs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6"
  }
}
