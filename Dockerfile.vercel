# syntax=docker/dockerfile:1.7
# Image de la démonstration Vercel (documentation/DEPLOIEMENT-VERCEL.md) : service « application » de vercel.json,
# lancé par le Container Runtime de Vercel (fonction qui s'arrête après 5 minutes sans trafic). Même construction que le
# Dockerfile de l'installation (client Vite servi par l'API), avec ces différences :
#   - pas de secret de construction : Vercel ne fournit pas « --mount=type=secret » ; la clé de construction est alors
#     tirée au hasard par CleConstruction.targets. Sans conséquence ici : aucun .env chiffré, toute la configuration
#     vient des variables d'environnement du projet Vercel (ConnectionStrings__LogiBTP, LOGIBTP_CLE_CHIFFREMENT…) ;
#   - pas de HTTPS dans le conteneur ni de certificat : Vercel termine le TLS et relaie en HTTP sur $PORT ;
#   - dossiers écrits sous /tmp (disque de l'instance, perdu à son arrêt) : GED, sauvegardes, journaux de repli ;
#   - pas de scripts SQL dans l'image : la base de démonstration est initialisée à part (scripts/demo/).
# Essai local (Docker Desktop) : docker build -f Dockerfile.vercel -t logibtp/demo . puis
#   docker run -p 8080:8080 -e PORT=8080 -e ConnectionStrings__LogiBTP="Host=…" -e LOGIBTP_CLE_CHIFFREMENT=… logibtp/demo

# ---------------------------------------------------------------- client web
FROM node:22-bookworm-slim AS client
WORKDIR /src
COPY . .
RUN npm ci --no-audit --no-fund && npm run build --workspace client

# ---------------------------------------------------------------- API
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS api
WORKDIR /src
COPY . .
RUN dotnet publish src/LogiBTP.Api -c Release -o /publication -p:UseAppHost=false

# ---------------------------------------------------------------- exécution
FROM mcr.microsoft.com/dotnet/aspnet:10.0
ENV ASPNETCORE_ENVIRONMENT=Production \
    TZ=Europe/Paris \
    LOGIBTP_DEPLOIEMENT=INTERNET \
    LOGIBTP_CONFIG=/app/config \
    LOGIBTP_CERTIFICATS=/app/certificats \
    LOGIBTP_SAUVEGARDES=/tmp/logibtp/sauvegardes \
    Ged__Repertoire=/tmp/logibtp/stockage-ged
WORKDIR /app
COPY --from=api /publication ./
COPY --from=client /src/client/dist ./wwwroot/
# Dossiers lus au démarrage (vides : ni societes.json, ni .env, ni certificat) et repli du journal technique.
RUN mkdir -p config certificats journaux \
 && chown app:app config certificats journaux
USER app
EXPOSE 8080
# Port d'écoute : PORT (variable du projet Vercel, 8080 ; le port 80 par défaut de Vercel est interdit au compte non root).
ENTRYPOINT ["bash", "-c", "mkdir -p /tmp/logibtp/sauvegardes /tmp/logibtp/stockage-ged && export ASPNETCORE_HTTP_PORTS=\"${PORT:-8080}\" && exec dotnet LogiBTP.Api.dll"]
