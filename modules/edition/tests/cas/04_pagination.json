      { "type": "PIED_PAGE", "pages": "DERNIERE", "contenu": { "type": "pile", "cadre": { "haut": "normal" }, "enfants": [
        { "type": "champ", "valeur": "Page {{Page()}} / {{NbPages()}} – dernière page", "style": "discret", "alignement": "centre" },
        { "type": "champ", "valeur": "Conditions générales jointes. Tout litige relève du tribunal de commerce du siège de l’entreprise.", "style": "mentions", "alignement": "centre" } ] } },
      { "type": "TITRE", "contenu": { "type": "champ", "valeur": "Essai de pagination {{numero}}", "style": "titre" } },
      { "type": "CORPS", "options": { "chaque_page": true }, "contenu": { "type": "champ", "valeur": "Quantitatif détaillé par lot", "style": "sous_titre", "cadre": { "bas": "fin" } } },
      { "type": "CORPS", "contenu": { "type": "champ", "multiligne": "auto", "alignement": "justifie",
