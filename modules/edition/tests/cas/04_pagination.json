      { "type": "CORPS", "mode": "GROUPE", "collection": "lignes", "rupture": "element.groupe", "options": { "entete_chaque_page": true },
        "entete": { "type": "champ", "valeur": "=groupe.valeur & Si(groupe.suite; \" (suite)\"; \"\")", "style": "section", "fond": "fond_section", "marges": 1 },
        "contenu": { "type": "rangee", "cadre": { "bas": "fin" }, "enfants": [
          { "type": "champ", "valeur": "{{element.code}}", "largeur": "18mm", "style": "petit" },
          { "type": "champ", "valeur": "{{element.libelle}}", "largeur": "*" },
          { "type": "champ", "valeur": "{{element.montant}}", "format": "montant", "alignement": "droite", "largeur": "25mm", "style": "montant" } ] },
        "pied": { "type": "champ", "valeur": "=\"Total \" & groupe.valeur & \" : \" & Montant(Somme(groupe.elements; \"montant\"))", "style": "sous_total", "alignement": "droite" } },
      { "type": "CORPS", "contenu": { "type": "saut_page" } },
      { "type": "CORPS", "contenu": { "type": "champ", "valeur": "Annexe : page commencée par un saut de page explicite.", "style": "gras" } }
    ]
