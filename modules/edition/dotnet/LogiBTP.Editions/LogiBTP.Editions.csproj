<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LogiBTP.Editions</RootNamespace>
    <Description>Module Édition LogiBTP : exécution du moteur d'édition JS (Jint) côté serveur, production des PDF.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\socle\dotnet\LogiBTP.Socle\LogiBTP.Socle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Paquet JS du moteur (généré par la commande construire du paquet JS du module). -->
    <EmbeddedResource Include="moteur\moteur-edition.js" LogicalName="moteur-edition.js" />
    <!-- Polices de l'édition (mêmes fichiers que le navigateur). -->
    <Content Include="..\..\js\polices\**\*.ttf;..\..\js\polices\**\OFL.txt" LinkBase="polices" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
