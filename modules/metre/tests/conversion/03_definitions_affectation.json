      },
      {
        "var_id": 3,
        "var_portee": "@@",
        "var_nom": "poids",
        "var_operation": "+=",
        "var_formule": "{{lig_qte}} * 10",
        "var_ordre": 3
      },
      {
        "var_id": 4,
        "var_portee": "@",
        "var_nom": "copie",
        "var_operation": "=",
        "var_formule": "{{@surface}}",
        "var_ordre": 4
      }
    ]
  },
  "attendu": {
    "mtr_resultat": 7.5,
    "variables": {
      "@surface": 7.5,
      "@@poids": 130,
      "@copie": 7.5
    },
    "mtr_variable": null,
    "script": [
      "// Métré converti depuis la saisie en lignes (valeurs, sous-détails, sous-totaux).",
      "local L1 est un numérique",
      "local L2 est un numérique",
      "local Resultat est un numérique",
      "",
      "L1 = 3",
      "L2 = 2,5",
      "Resultat = L1 * L2",
      "@surface = Resultat",
      "",
      "// Variables définies par le métré",
      "@@poids_m2 = 12",
      "@@poids = {{@surface}} * {{@@poids_m2}}",
      "@@poids += {{lig_qte}} * 10",
      "@copie = {{@surface}}",
      "Renvoyer Resultat"
    ]
  }
