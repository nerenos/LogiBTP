        "mli_ordre": 1,
        "mli_type": "V",
        "mli_operateur": "+",
        "mli_formule": "3"
      },
      {
        "mli_id": 402,
        "mli_mtr_id": 30,
        "mli_parent_id": null,
        "mli_ordre": 2,
        "mli_type": "V",
        "mli_operateur": "*",
        "mli_formule": "2,5"
      }
    ],
    "definitions": [
      {
