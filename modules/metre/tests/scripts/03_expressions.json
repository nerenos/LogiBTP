{
  "nom": "Expressions",
  "description": "Priorités, unaires, modulo, virgule ou point décimal, continuation de ligne, opérateurs Unicode, comparaisons, logique (court-circuit), concaténation, arrondi à l'affectation.",
  "cas": [
    {
      "nom": "Priorité mathématique",
      "entree": {
