      "attendu": {
        "resultat": 2.75
      }
    },
    {
      "nom": "Continuation : parenthèse ouverte, opérateur en début ou en fin de ligne",
      "entree": {
        "script": [
          "local x est un numérique",
          "x = (",
          "    + 2     // a",
