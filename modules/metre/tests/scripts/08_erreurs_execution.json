{
  "nom": "Erreurs d'exécution",
  "description": "L'exécution s'arrête à la première erreur ; pas de résultat, les variables gardent leur dernière valeur.",
  "cas": [
    {
      "nom": "Type : chaîne affectée à un numérique",
      "entree": {
        "script": [
          "local x est un numérique",
          "x = \"a\"",
          "Renvoyer x"
        ]
      },
      "attendu": {
        "erreurs": [
          {
            "code": "TYPE",
            "ligne": 2,
            "colonne": 3
          }
        ],
        "variables": {
          "x": 0
        }
      }
    },
    {
      "nom": "Type : condition non booléenne",
      "entree": {
        "script": [
          "Si 1 alors",
          "Fin",
          "Renvoyer 1"
        ]
      },
      "attendu": {
        "erreurs": [
          {
            "code": "TYPE",
            "ligne": 1,
            "colonne": 4
          }
        ]
      }
    },
    {
