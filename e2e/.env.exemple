# Comptes des tests Playwright : copier en e2e/.env (hors dépôt) et renseigner.
# Les mots de passe ne servent que si l'API n'offre pas la connexion de test (ComptesTest, développement).

# Compte administrateur (tous les droits).
E2E_ADMIN_ID=
E2E_ADMIN_MDP=

# Compte d'un profil SANS droit sur le nœud « fiches/salarie » (ni consultation ni modification)
# et sans droit sur le paramétrage : sert aux tests de sécurité (e2e/droits.spec.ts).
E2E_RESTREINT_ID=
E2E_RESTREINT_MDP=

# Adresse du client (par défaut http://localhost:5173).
# BASE_URL=

# Comptes du contrôle du N+1 (e2e/ordres-controle-n1.spec.ts), facultatifs : créés par le scénario pour les salariés
# « Noël Vincent » et « Jérôme Boyer » de la démonstration (profil Saisie) ; identifiants par défaut e2e_executant, e2e_n1.
# Sans connexion de test, leur mot de passe est remplacé à chaque passage (aucun mot de passe à renseigner).
# E2E_EXECUTANT_ID=
# E2E_N1_ID=

# Compte de l'application de terrain (e2e/pointage-terrain.spec.ts), facultatif : créé par le scénario pour la salariée
# « Chloé Blanc » de la démonstration (profil MOBILE) ; identifiant par défaut e2e_terrain.
# E2E_TERRAIN_ID=

# Compte de la salariée du CRM (e2e/crm-notes.spec.ts, e2e/crm-demandes.spec.ts), facultatif : créé par les scénarios
# pour « Maëlys Garçon » du service Administration (bureau) de la démonstration (profil SAISIE) ; défaut e2e_crm.
# E2E_CRM_ID=

# Reprise de données MDE / OptimBTP (e2e/reprise.spec.ts), facultatif : société NEUVE (aucune donnée métier) et base
# source de test montée par tests/reprise/monter.sh (jamais une base réelle). Le parcours écrit dans cette société.
# E2E_REPRISE_URL=http://reprise.localhost:5173
# E2E_REPRISE_SOURCE=MDE
# E2E_REPRISE_CONNEXION=
