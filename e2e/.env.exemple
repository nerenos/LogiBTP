# Comptes des tests Playwright : copier en e2e/.env (hors dépôt) et renseigner.
# Les mots de passe ne servent que si l'API n'offre pas la connexion de test (ComptesTest, développement).

# Compte administrateur (tous les droits).
E2E_ADMIN_ID=
E2E_ADMIN_MDP=

# Compte d'un profil SANS droit sur le nœud « fiches/salarie » (ni consultation ni modification)
# et sans droit sur le paramétrage : sert aux tests de sécurité (e2e/droits.spec.ts).
E2E_RESTREINT_ID=
E2E_RESTREINT_MDP=

# Adresse du client (par défaut http://localhost:5173).
# BASE_URL=
