{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "services": {
    "application": {
      "root": "./",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "documentation": {
      "root": "docs/",
      "framework": "vitepress",
      "installCommand": "cd .. && npm ci --workspace docs --include-workspace-root=false --no-audit --no-fund",
      "buildCommand": "LOGIBTP_DOCS_BASE=/documentation/ npm run build",
      "outputDirectory": ".vitepress/dist"
    }
  },
  "rewrites": [
    {
      "source": "/documentation/(.*)",
      "destination": {
        "service": "documentation"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "application"
      }
    }
  ],
  "redirects": [
    {
      "source": "/documentation",
      "destination": "/documentation/",
      "permanent": false
    }
  ]
}
