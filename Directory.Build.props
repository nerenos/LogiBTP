<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- SQL brut : aucune chaîne interpolée (EF1002) ni concaténée (EF1003) non constante passée à une méthode Raw. -->
    <WarningsAsErrors>$(WarningsAsErrors);EF1002;EF1003</WarningsAsErrors>
  </PropertyGroup>
</Project>
